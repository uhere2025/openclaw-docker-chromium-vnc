# Copy to .env and set a real value. .env is gitignored.
VNC_PASSWORD=change-me

# Host ports (override per instance to run more than one stack)
AGENT_PORT=18790
VNC_PORT=6080

# Host paths for the agent's persisted state. Defaults work for a single stack;
# give each extra instance its own dirs so they don't clobber each other:
#   CONFIG_DIR=./agent/inst-b/config
#   WORKSPACE_DIR=./agent/inst-b/workspace
CONFIG_DIR=./agent/config
WORKSPACE_DIR=./agent/workspace
